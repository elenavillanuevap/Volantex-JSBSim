<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript name="ex2400_rudzero">
  <description>Trim the EX2400 and then force the rudder to zero.</description>

  <use aircraft="ex2400_trim" initialize="ex2400_trim_init" />

  <run start="0.0" end="15.0" dt="0.01">
    <!-- Reference condition from VSPAERO: Vinf = 15 m/s = 29.1577 kt, level flight. -->
    <property value="29.1577">ic/vt-kts</property>
    <property value="328.084">ic/h-sl-ft</property>
    <property value="0.40">ic/alpha-deg</property>
    <property value="0.0">ic/beta-deg</property>
    <property value="0.0">ic/gamma-deg</property>
    <property value="0.40">ic/theta-deg</property>
    <property value="0.0">ic/phi-deg</property>
    <property value="0.0">ic/psi-deg</property>
    <property value="0.0">ic/p-rad_sec</property>
    <property value="0.0">ic/q-rad_sec</property>
    <property value="0.0">ic/r-rad_sec</property>
    <property value="0.0">fcs/aileron-cmd-norm</property>
    <property value="0.0">fcs/elevator-cmd-norm</property>
    <property value="0.0">fcs/rudder-cmd-norm</property>
    <property value="0.0">fcs/pitch-trim-cmd-norm</property>
    <property value="0.0">fcs/roll-trim-cmd-norm</property>
    <property value="0.0">fcs/yaw-trim-cmd-norm</property>
    <property value="1">propulsion/engine[0]/set-running</property>
    <property value="0.25">fcs/throttle-cmd-norm</property>
    <property value="0">gear/unit/WOW</property>
    <property value="0">gear/unit[2]/WOW</property>

    <event name="Set engine running">
      <condition>simulation/sim-time-sec le 0.01</condition>
      <set name="propulsion/engine[0]/set-running" value="1" />
      <set name="fcs/throttle-cmd-norm" value="0.25" />
    </event>

    <event name="Initial trim">
      <condition>simulation/sim-time-sec ge 0.02</condition>
      <set name="simulation/do_simple_trim" value="1" />
    </event>

    <event name="Force Zero Rudder Controls" continuous="true">
      <condition>simulation/sim-time-sec ge 3.0</condition>
      <set name="fcs/rudder-cmd-norm" value="0.0" />
      <set name="fcs/yaw-trim-cmd-norm" value="0.0" />
    </event>

    <event name="Force Zero Rudder Surface" continuous="true">
      <condition>simulation/sim-time-sec ge 3.0</condition>
      <set name="fcs/rudder-pos-rad" value="0.0" />
    </event>

    <event name="Report After Rudder Zero">
      <condition>simulation/sim-time-sec ge 3.0</condition>
      <notify>
        <property>simulation/sim-time-sec</property>
        <property>simulation/trim-completed</property>
        <property>position/h-sl-ft</property>
        <property>attitude/phi-deg</property>
        <property>attitude/theta-deg</property>
        <property>aero/alpha-deg</property>
        <property>aero/beta-deg</property>
        <property>fcs/rudder-pos-rad</property>
        <property>fcs/throttle-cmd-norm</property>
        <property>fcs/throttle-pos-norm</property>
        <property>velocities/p-rad_sec</property>
        <property>velocities/q-rad_sec</property>
        <property>velocities/r-rad_sec</property>
      </notify>
    </event>
  </run>
</runscript>

